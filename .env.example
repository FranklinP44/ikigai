# Environment variables for the Ikigai repository.
#
# The app itself needs none of these: `npm install`, `npm run dev`, `npm run build`,
# `npm run test`, and the other npm scripts work with no .env file. The page reads no
# environment variables at runtime, and Vite only exposes variables prefixed with VITE_
# to browser code, so nothing below can leak into the built site.
#
# The variables below are used only by .github/scripts/publish_confluence.py, which
# publishes droid-wiki/ to Confluence. In CI they come from the repository's Actions
# variables and secrets (see .github/workflows/publish-wiki-to-confluence.yml). To run
# the script locally:
#
#   cp .env.example .env        # .env is gitignored; never commit it
#   # fill in the values, then:
#   set -a; . ./.env; set +a
#   python .github/scripts/publish_confluence.py --dry-run
#
# With --dry-run the script converts pages and renders diagrams into build/confluence/.
# If the four required Confluence variables are set, it also runs read-only checks
# against Confluence; otherwise it skips them. Without --dry-run all four are required
# and the script writes pages to Confluence.

# --- Required to talk to Confluence -------------------------------------------------

# Confluence Cloud site URL, such as https://your-site.atlassian.net (Actions variable).
CONFLUENCE_URL=

# Key of the space to publish into (Actions variable).
CONFLUENCE_SPACE_KEY=

# Atlassian account email that owns the API token (Actions secret).
CONFLUENCE_EMAIL=

# API token from https://id.atlassian.com/manage-profile/security/api-tokens (Actions secret).
CONFLUENCE_API_TOKEN=

# --- Optional -----------------------------------------------------------------------

# Title of the root page that holds the wiki. Default: Ikigai wiki
CONFLUENCE_ROOT_TITLE=

# ID of the page to create the root page under. Default: the space homepage.
CONFLUENCE_PARENT_ID=

# Wiki folder to publish. Default: droid-wiki
WIKI_DIR=

# Command that runs mermaid-cli to render diagrams. Default: mmdc
# Install it with: npm install -g @mermaid-js/mermaid-cli@11
MMDC=

# --- Set by GitHub Actions; leave unset locally -------------------------------------
#
# GITHUB_ACTIONS        switches the Vitest reporters and the publish script's log
#                       format to GitHub annotations.
# GITHUB_STEP_SUMMARY   file that npm run test:durations and the publish script append
#                       their summary tables to.
# GITHUB_SERVER_URL, GITHUB_REPOSITORY, GITHUB_SHA
#                       build the source links on Confluence pages. Locally the script
#                       falls back to the origin remote and the current commit.
